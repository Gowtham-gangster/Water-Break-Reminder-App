{
  "name": "pauseflow",
  "productName": "PauseFlow",
  "version": "1.0.0",
  "description": "Digital wellness desktop application for hydration and healthy screen breaks.",
  "author": "PauseFlow Team",
  "main": "index.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop": "electron index.cjs",
    "desktop:dev": "tsc -b && vite build && electron index.cjs",
    "package:win": "npm run build && electron-builder --win --dir -p never",
    "dist:win": "npm run build && electron-builder --win nsis -p never",
    "dist:all": "npm run build && electron-builder --win nsis zip dir -p never",
    "dist": "npm run dist:all",
    "release": "npm run dist:all",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:apk": "npm run android:build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.pauseflow.desktop",
    "productName": "PauseFlow",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "index.cjs",
      "dist/**/*",
      "desktop/**/*",
      "public/**/*"
    ],
    "win": {
      "executableName": "PauseFlow",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PauseFlow",
      "uninstallDisplayName": "PauseFlow Digital Wellness",
      "runAfterFinish": true,
      "artifactName": "PauseFlow-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
