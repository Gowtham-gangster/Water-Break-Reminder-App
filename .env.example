# EyeFlow V2 — Environment Variables Example
# Copy this file to .env or .env.local to configure your environment.

# Application Environment
VITE_APP_ENV=development
VITE_APP_VERSION=2.0.0-rc1
VITE_STORAGE_PREFIX=eyeflow:v2:

# Supabase Configuration
# Required for EyeFlow V2 Multi-User Cloud Synchronization and Authentication.
# Obtain these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL=https://hwrsvdrhqenraeuqfqle.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_n703UIXn1S4fNHaqmC8yKQ_gwmYEry1
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_n703UIXn1S4fNHaqmC8yKQ_gwmYEry1

# Optional: Dedicated Backend API fallback URL (if utilizing self-hosted instance)
VITE_API_BASE_URL=http://localhost:5000/api
