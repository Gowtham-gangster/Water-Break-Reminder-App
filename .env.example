# PauseFlow — Environment Variables Template
# Copy this file to .env to configure your local environment.

# Application Configuration
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_STORAGE_PREFIX=pauseflow:v2:

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
